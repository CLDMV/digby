{
	"name": "@cldmv/digby",
	"version": "0.0.1",
	"description": "Digby — built on @cldmv/rummage.",
	"type": "module",
	"license": "Apache-2.0",
	"author": { "name": "Shinrai", "company": "CLDMV", "email": "git+npm@cldmv.net", "url": "https://cldmv.net" },
	"contributors": [{ "name": "CLDMV", "url": "https://github.com/CLDMV" }],
	"funding": { "type": "github", "url": "https://github.com/sponsors/shinrai" },
	"engines": { "node": ">=22.5.0" },
	"repository": { "type": "git", "url": "git+https://github.com/CLDMV/digby.git" },
	"bugs": { "url": "https://github.com/CLDMV/digby/issues" },
	"homepage": "https://github.com/CLDMV/digby#readme",
	"main": "src/app.mjs",
	"dependencies": { "@cldmv/rummage": "workspace:*" },
	"devDependencies": { "electron": ">=42", "electron-builder": "^26.0.0" },
	"scripts": {
		"start": "electron .",
		"dev": "electron . --dev",
		"start:http": "rummage run --target desktop --renderer src --http",
		"build:web": "rummage build --target web --renderer src",
		"build": "electron-builder",
		"generate": "rummage generate",
		"generate:check": "rummage check",
		"launchLocal:dev": "node .deskport/trigger.mjs dev"
	},
	"build": {
		"appId": "net.cldmv.digby",
		"productName": "Digby",
		"files": ["src/**", "node_modules/**"],
		"win": { "target": "nsis" }
	}
}
